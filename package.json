{
  "name": "astro-textile",
  "version": "0.0.0",
  "description": "Textile integration for Astro",
  "homepage": "https://github.com/r8/astro-textile#readme",
  "bugs": {
    "url": "https://github.com/r8/astro-textile/issues"
  },
  "license": "MIT",
  "author": "Sergey Storchay <r8@r8.com.ua>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r8/astro-textile.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "publint": "publint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepublishOnly": "yarn build"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "publint": "^0.3.24",
    "tsdown": "^0.22.5",
    "typescript": "^6",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
